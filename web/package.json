{
  "name": "cascade-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Server + web UI for the leak-detection rig: one Node process serving Next.js, a WebSocket hub and SQLite history.",
  "engines": {
    "node": ">=22.18 <23"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false --ignore src --ignore .next server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/protocol.test.ts",
    "fake": "node --disable-warning=ExperimentalWarning --import tsx scripts/fake-device.ts",
    "smoke": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke.ts",
    "brand": "node ../scripts/gen-branding.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serialport": "13.0.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "three": "^0.185.0",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "uplot": "1.6.32",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
